__pycache__/
*.pyc
outputs/*
!outputs/.gitkeep
data/*
!data/PUT_CLIENT_SHAPEFILE_HERE.txt
!data/.gitkeep
secrets/*
!secrets/README.md
!secrets/.gitkeep
.idea/

# Per-client config: display name, precise plot/alert-bbox lat-lon,
# threshold overrides. Backend-only input to publish_site.py - the
# frontend never reads these directly, only the filtered subset
# publish_site.py derives into docs/c/<slug>/data/client_meta.json.
# Keep only the schema template tracked.
clients/*
!clients/_example.json.template
!clients/.gitkeep

# Defense-in-depth beyond secrets/*: catches a key/credential dropped
# anywhere else in the tree by mistake (wrong working directory, a copy-
# paste into the repo root, ...) rather than relying solely on it landing
# in the one folder we remember to gitignore. See secrets/README.md for
# where real credentials are actually supposed to live.
.env
.env.*
*.pem
*.key
*_api_key.txt
*_sensor_api_key.txt
